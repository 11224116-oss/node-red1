    {
        "id": "493881e77d8718b8",
        "type": "ui_template",
        "z": "8479a3a703296198",
        "group": "gc00000000000002",
        "name": "全班廣播歷史留言板",
        "order": 3,
        "width": 0,
        "height": 0,
        "format": "<div style=\"max-height: 280px; overflow-y: auto; padding: 4px;\">\n  <div ng-if=\"!msg.payload.history || msg.payload.history.length === 0\" style=\"color: #888; text-align: center; padding: 16px;\">\n    尚未收到任何全班廣播訊息...\n  </div>\n  <div ng-repeat=\"item in msg.payload.history\" style=\"border-left: 4px solid {{item.category === 'alert' ? '#ef4444' : (item.category === 'status' ? '#22c55e' : '#3b82f6')}}; background: #f8fafc; padding: 8px 12px; margin-bottom: 8px; border-radius: 4px; color: #1e293b;\">\n    <div style=\"font-size: 12px; color: #64748b; display: flex; justify-content: space-between;\">\n      <span><b>{{item.sender}}</b> ・ {{item.catLabel}}</span>\n      <span>{{item.time}}</span>\n    </div>\n    <div style=\"font-size: 15px; margin-top: 4px; word-break: break-all;\">{{item.content}}</div>\n  </div>\n</div>",
        "storeOutMessages": true,
        "fwdInMessages": true,
