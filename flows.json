    {
        "id": "26142716781cbaf8",
        "type": "function",
        "z": "8479a3a703296198",
        "name": "組合 user6 廣播 Topic 與內容",
        "func": "const category = flow.get(\"c_category\") || \"announcement\";\nconst text = (flow.get(\"c_text\") || \"\").trim();\n\nif (!text) {\n    node.warn(\"請先輸入廣播訊息內容再發送！\");\n    return null;\n}\n\nmsg.topic = `AIOT/user6/message/${category}`;\nmsg.payload = text;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
