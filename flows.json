    {
        "id": "9dd38c6648371e2d",
        "type": "function",
        "z": "8479a3a703296198",
        "name": "解析發送者與訊息類別",
        "func": "const topic = msg.topic || \"\";\nconst parts = topic.split(\"/\");\n// Topic 格式: AIOT / userX / message / category\nconst sender = parts[1] || \"未知使用者\";\nconst category = parts[3] || \"一般\";\nconst content = (typeof msg.payload === \"object\") ? JSON.stringify(msg.payload) : String(msg.payload);\nconst now = new Date().toLocaleTimeString('zh-TW', { hour12: false });\n\nconst catMap = {\n    \"announcement\": \"📢 公告 (announcement)\",\n    \"alert\": \"🚨 警報 (alert)\",\n    \"status\": \"ℹ️ 狀態 (status)\"\n};\nconst catLabel = catMap[category] || category;\n\n// 保留最近 10 筆全班廣播紀錄\nlet history = flow.get(\"c_history\") || [];\nhistory.unshift({\n    time: now,\n    sender: sender,\n    category: category,\n    catLabel: catLabel,\n    content: content\n});\nif (history.length > 10) {\n    history = history.slice(0, 10);\n}\nflow.set(\"c_history\", history);\n\nmsg.payload = {\n    sender: sender,\n    catLabel: catLabel,\n    content: content,\n    time: now,\n    topic: topic,\n    history: history\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
